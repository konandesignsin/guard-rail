# Clerk — https://dashboard.clerk.com (your app → API keys)
# NEXT_PUBLIC_ vars are inlined at build time — set them on Vercel, then redeploy.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret — Clerk dashboard → Webhooks → your endpoint → Signing Secret (starts with whsec_)
CLERK_WEBHOOK_SECRET=

# Neon Postgres — https://console.neon.tech (your project → Connection string)
DATABASE_URL=

# Resend — https://resend.com (API Keys; starts with re_)
RESEND_API_KEY=

# From address for outgoing email (e.g. "Guardrail <hello@yourdomain.com>").
# Falls back to onboarding@resend.dev, which can only deliver to your own Resend account email until a domain is verified.
EMAIL_FROM=

# Public base URL of the app (used in emails and callbacks), e.g. https://guardrail.example.com
NEXT_PUBLIC_APP_URL=

# Shared secret for future cron routes (send bearer token in Authorization header)
CRON_SECRET=

# Local only: recipient address for scripts/test-resend.ts
TEST_EMAIL=

# Feature flags: Show demo / sample preview report routes (true/false)
NEXT_PUBLIC_SHOW_PREVIEW_ROUTES=false

